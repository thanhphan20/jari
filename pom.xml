<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>jari</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Jari - Jira Clone</name>
    <description>Jira Clone Microservices Architecture</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.40</lombok.version>
        <flyway.version>9.22.3</flyway.version>
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <modules>
        <module>jari-common</module>
        <module>jari-security</module>
        <module>jari-test-support</module>
        <module>jari-discovery</module>
        <module>jari-gateway</module>
        <module>jari-user-service</module>
        <module>jari-project-service</module>
        <module>jari-task-service</module>
        <module>jari-notification-service</module>
    </modules>

    <!-- Every module gets the test toolchain (JUnit 5, Mockito, AssertJ, Spring
         test support) rather than each pom repeating it. Version comes from
         spring-boot-starter-parent. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <!-- *IT classes are integration tests (Failsafe, `mvn verify`, need a
                     container runtime); everything else is a unit test (Surefire,
                     `mvn test`, no container runtime required). Timezone pinned to
                     UTC on both so the suite's result doesn't depend on the
                     developer's machine locale/timezone (Postgres 18 also rejects
                     some legacy zone aliases the JVM default can carry, e.g.
                     Asia/Saigon). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                        <argLine>-Duser.timezone=UTC</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- Failsafe isn't bound to the default jar lifecycle the way Surefire
             is, so it must be declared here (inherited by every child module)
             rather than left in pluginManagement alone, or *IT classes would
             never run. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- api.version pins docker-java's negotiated Docker Engine API version.
                         Without it, docker-java negotiates down to an old version (~1.24-1.32)
                         that newer Docker Engines (29.x, MinAPIVersion 1.40) reject with a
                         malformed empty-body 400 - surfacing as "Could not find a valid Docker
                         environment" with no hint that the real cause is API version, not a
                         missing runtime. 1.41 is old enough to be supported everywhere. -->
                    <argLine>-Duser.timezone=UTC -Dapi.version=1.41</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
